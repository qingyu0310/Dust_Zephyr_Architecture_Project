# Application thread and feature configuration.

rsource "../drivers/Kconfig"
rsource "../algorithm/Kconfig"
rsource "../modules/Kconfig"
rsource "../topic/Kconfig"
rsource "../cmd/Kconfig"

# ============================================================================

# =================       功能配置区 — 各模块开关       ========================

config USE_CMD_SHELL
    bool "Shell debug thread"
    default n
    select CMD_SHELL_VAR
    help
      Shell debug variable thread — l/g/s commands via UART.

config USE_CMD_BUZZER
    bool "Buzzer control"
    default n
    select CMD_BUZZER
    help
      Buzzer control — PWM beep via cmd/buzzer.

config USE_CMD_FLASH
    bool "SPI Flash"
    default n
    select CMD_FLASH
    help
      SPI NOR Flash read/write/erase via cmd/flash.

# ============================================================================

# =================               TRD_GPIO                ====================

config TRD_GPIO
    bool "GPIO thread task"
    default y
    select DEV_GPIO_OUTPUT
    select CTL_TIMER
    help
      Enable the GPIO/output indicator thread.

# ============================================================================

# =================               TRD_CHASSIS             ====================

config TRD_CHASSIS
    bool "Chassis control thread"
    default n
    select MOD_CTL_POWER
    select MOD_DEV_MOTOR_DJI
    select TPC_TO_CAN_TX
    select TPC_REMOTE_TO
    help
      Enable chassis control thread.

config USE_POWERMETER
    bool "Power meter"
    depends on TRD_CHASSIS
    default n
    select MOD_DEV_POWERMETER
    help
      Enable power meter support for chassis control.

# ============================================================================

# =================               TRD_GIMBAL               ====================

config TRD_GIMBAL
    bool "Gimbal control thread"
    default n
    select CTL_PID
    select MOD_DEV_MOTOR_DM
    select TPC_TO_CAN_TX
    select TPC_REMOTE_TO
    help
      Enable gimbal control thread.

# ============================================================================

# =================               TRD_CAN_TX              ====================

config TRD_CAN_TX
    bool "CAN TX thread"
    default n
    select COM_CAN
    select TPC_TO_CAN_TX
    help
      Enable CAN TX thread.

# ============================================================================

# =================               TRD_REMOTE              ====================

config TRD_REMOTE
    bool "Remote thread"
    default n
    select MOD_DEV_REMOTE
    select MOD_DEV_REMOTE_AUTO
    help
      Enable remote receiver thread.

# ============================================================================

# =================               TRD_IMU                 ====================

config TRD_IMU
    bool "IMU thread"
    default y
    select MOD_DEV_IMU
    select TPC_IMU_TO
    help
      Enable IMU acquisition, heater control, and publish thread.

config IMU_IDENTIFICATION
    bool "IMU heater identification"
    default n
    depends on TRD_IMU
    select MOD_DEV_IMU_IDENT
    help
      IMU heater open-loop identification, replaces PID closed-loop control.

# ============================================================================

# =================               TRD_TFLM                ====================

config TRD_TFLM
    bool "TFLM inference thread"
    default n
    select TFLM
    help
      Enable TFLM inference test thread.

# ============================================================================

# =================               TRD_PC                  ====================

config TRD_PC
    bool "PC communication thread"
    default n
    select COM_USB
    help
      PC communication thread (USB CDC ACM loopback test).

# ============================================================================

# =================               TRD_TEST                ====================

config TRD_TEST
    bool "User test add config"
    default n
    select COM_USB
    help
      Temporary user test switch.

# ============================================================================
