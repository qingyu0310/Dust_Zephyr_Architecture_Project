#include <dt-bindings/pinctrl/hpmicro-pinctrl-common.h>
#include <dt-bindings/gpio/gpio.h>

/ {
    aliases {
        shell-uart = &uart0;
        ethercat0  = &esc0;
    };
};

&gpiod {
    pinctrl-0 = <&pinmux_gpiod_pd14_pd15>;
    pinctrl-names = "default";
    status = "okay";
};

&gpiof {
    status = "okay";
    pinctrl-0 = <&pinmux_esc_gpio>;
    pinctrl-names = "default";
};

&esc0 {
    status = "okay";
    pinctrl-0 = <&pinmux_esc0>;
    pinctrl-names = "default";
    phy-reset-gpios = <&gpiof 28 GPIO_ACTIVE_LOW>;
    phy-addr-offset = <0>;
    /* Port0: RTL8201F at MDIO 1; port1: TJA1101B at MDIO 0 (schematic straps). */
    software-link0;
    software-link1;
    port1-enabled;
    phys = <&ecat_phy0 &ecat_phy1>;
};

/ {
    /* EtherCAT PHY：驱动由 compatible 选中，参数在这里填 */
    ecat_phy0: ethercat-phy-1 {
        compatible = "hpmicro,ecat-phy-rtl8201f";
        mdio-address = <1>;
        phy-mode = "mii";
        autoneg;
        advertise = <0x0100>;      /* 只通告 100BASE-TX 全双工 */
    };

    ecat_phy1: ethercat-phy-0 {
        compatible = "hpmicro,ecat-phy-tja1101b";
        mdio-address = <0>;
        phy-mode = "mii";
        autoneg;
        master-slave = "auto";
    };
};

&uart0 {
    current-speed = <921600>;
    status = "okay";
};

&hdma { status = "okay"; };
